# Server
PORT=3000

# Comma-separated list of allowed origins for Socket.IO.
# Use * for local testing only.
# Supports exact origins and wildcards (for example https://*.vercel.app).
CORS_ORIGIN=http://localhost:3000,https://your-vercel-project.vercel.app

# Keep-alive clock (optional)
# true or false
KEEP_ALIVE_ENABLED=false

# Keep-alive interval in milliseconds (default: 14 minutes)
KEEP_ALIVE_INTERVAL_MS=840000

# URL to ping. Leave empty to use local /health endpoint.
# For Render, set this to your public health URL.
KEEP_ALIVE_URL=

# Frontend runtime config (Vercel API reads this env var)
# Example: https://your-render-service.onrender.com
SIGNAL_SERVER_URL=

# Optional TURN relay config for restricted networks (recommended for production)
# Demo relay for quick testing. Replace with your own TURN service for production.
TURN_URLS=turn:openrelay.metered.ca:80,turn:openrelay.metered.ca:443?transport=tcp
TURN_USERNAME=openrelayproject
TURN_CREDENTIAL=openrelayproject
